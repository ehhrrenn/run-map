# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Google Maps JavaScript API key (enable Maps JavaScript API, Directions API,
# Roads API, and Elevation API on this key in Google Cloud Console).
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID (Cloud Console > Google Maps Platform > Map Management),
# required for AdvancedMarker to render with your own styling. Defaults to
# Google's public "DEMO_MAP_ID" (watermarked) if left unset.
VITE_GOOGLE_MAPS_MAP_ID=

# Firebase web app config (Firebase Console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
